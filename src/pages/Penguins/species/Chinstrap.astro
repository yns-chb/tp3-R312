---
import GraphicSpecies from "../../../components/GraphicSpecies.astro";
import Layout from "../../../layouts/Layout.astro";
---

<Layout>
    <main class="min-h-screen bg-slate-50 px-6 py-12 text-slate-900 md:py-16">
        <div class="mx-auto max-w-5xl">
           
            <header class="mt-8 border-l-4 border-rose-600 pl-5">
                <p
                    class="text-sm font-bold uppercase tracking-[0.2em] text-rose-700"
                >
                    Profil de l’espèce
                </p>
                <h1 class="mt-2 text-4xl font-bold tracking-tight md:text-5xl">
                    Chinstrap
                </h1>
                <p class="mt-3 max-w-2xl text-lg text-slate-600">
                    Explorez la relation entre la longueur et la profondeur du
                    culmen.
                </p>
            </header>
            <section
                class="mt-10 bg-white p-4 shadow-lg ring-1 ring-slate-200 md:p-8"
                aria-label="Graphique des Chinstrap"
            >
                <GraphicSpecies species="Chinstrap" />
            </section>
        </div>
    </main>
</Layout>
