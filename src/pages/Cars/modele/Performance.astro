---
import GraphicModele from "../../../components/GraphicModele.astro";
import Layout from "../../../layouts/Layout.astro";
---

<Layout>
    <main class="min-h-screen bg-slate-50 px-6 py-12 text-slate-900 md:py-16">
        <div class="mx-auto max-w-6xl">
            <header class="max-w-3xl">
                <p
                    class="text-sm font-bold uppercase tracking-[0.2em] text-amber-700"
                >
                    Analyse automobile
                </p>
                <h1 class="mt-2 text-4xl font-bold tracking-tight md:text-5xl">
                    Performance et consommation
                </h1>
                <p class="mt-4 text-lg leading-8 text-slate-600">
                    Comparez la puissance des voitures avec leur consommation de
                    carburant.
                </p>
            </header>
            <section
                class="mt-10 bg-white p-4 shadow-lg ring-1 ring-slate-200 md:p-8"
            >
                <GraphicModele view="performance" />
            </section>
        </div>
    </main>
</Layout>
